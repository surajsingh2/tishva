{%- doc -%}
  Renders the search action button.
{%- enddoc -%}

{% unless style == 'none' %}
  <search-button class="search-action tishva-search-action-wrapper">
    <button
      on:click="#search-modal/showDialog"
      class="button-unstyled tishva-header-search-btn"
      aria-label="{{ 'content.search_input_label' | t }}"
      aria-haspopup="dialog"
    >
      <div class="tishva-search-container">
        <span class="tishva-search-label">SEARCH</span>
        <div class="tishva-search-line"></div>
      </div>
    </button>
  </search-button>
{% endunless %}

<style>
  .search-action.tishva-search-action-wrapper {
    display: flex !important;
    align-items: center;
  }

  .tishva-header-search-btn {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: flex-end;
  }

  .tishva-search-container {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    width: 150px;
  }

  .tishva-search-label {
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: inherit;
    line-height: 1;
    margin-bottom: 4px;
    padding-right: 2px;
  }

  .tishva-search-line {
    width: 100%;
    height: 1px;
    background-color: currentColor;
    opacity: 0.85;
    transition: opacity 0.2s ease, height 0.2s ease;
  }

  .tishva-header-search-btn:hover .tishva-search-line {
    opacity: 1;
    height: 1.5px;
  }

  @media screen and (max-width: 749px) {
    .tishva-search-container {
      width: 110px;
    }
  }
</style>
