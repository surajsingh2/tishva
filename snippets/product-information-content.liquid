{% doc %}
  Product Information Content

  Renders the product information layout with media gallery and product details.
  Used by both product-information and featured-product-information sections.

  @param {product} product - Product object
  @param {string} section_id - Unique section ID
  @param {object} settings - Section settings object
  @param {string} media_gallery - Captured HTML for the product media gallery block
  @param {string} product_details - Captured HTML for the product details block
  @param {string} additional_blocks - Captured HTML for additional section blocks

  @example
  {% capture media_gallery %}
    {% content_for 'block', type: '_product-media-gallery', id: 'media-gallery', closest.product: product %}
  {% endcapture %}

  {% capture product_details %}
    {% content_for 'block', type: '_product-details', id: 'product-details', closest.product: product %}
  {% endcapture %}

  {% capture additional_blocks %}
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'product-information-content',
    product: product,
    section_id: section.id,
    settings: section.settings,
    media_gallery: media_gallery,
    product_details: product_details,
    additional_blocks: additional_blocks
  %}
{% enddoc %}

{% liquid
  # Determine render order based on media position
  if settings.desktop_media_position == 'left'
    assign render_order = 'media,product-details'
  else
    assign render_order = 'product-details,media'
  endif

  # Check if product has media
  assign product_has_media = true
  if product.media.size == 0
    assign product_has_media = false
  endif

  # Build product grid class
  assign product_grid_class = 'product-information__grid'

  if product_has_media == false
    assign product_grid_class = product_grid_class | append: ' product-information--media-none'
  elsif settings.desktop_media_position == 'right'
    assign product_grid_class = product_grid_class | append: ' product-information--media-right'
  else
    assign product_grid_class = product_grid_class | append: ' product-information--media-left'
  endif

  if settings.equal_columns
    assign product_grid_class = product_grid_class | append: ' product-information__grid--half'

    if settings.limit_details_width
      assign product_grid_class = product_grid_class | append: ' product-information__grid--limit-details'
    endif
  endif

  # Determine content width
  case settings.content_width
    when 'content-center-aligned'
      assign content_width = 'page-width'
    when 'content-full-width'
      assign content_width = 'full-width'
  endcase
%}

{% liquid
  if settings.background_color != blank
    render 'contrast-override', background_color: settings.background_color, section_id: section_id
  endif
%}

<div
  class="section-background{% if settings.background_color != blank %} color-custom-{{ section_id }}{% endif %}"
></div>
<div
  class="product-information section section--{{ content_width }} spacing-style{% if settings.background_color != blank %} color-custom-{{ section_id }}{% endif %} relative"
  style="{% render 'spacing-style', settings: settings %} --gap: {{ settings.gap }}px;"
  data-testid="product-information"
>
  {% if request.page_type == 'product' or template.name == 'product' %}
    <div class="pdp-collection-subtitle">
      // COLLECTION {{ product.collections.first.title | default: 'SCANDALICIOUS' | upcase }}
    </div>
  {% endif %}
  <product-component
    class="{{ product_grid_class }}"
    data-product-grid-content
    {% # theme-check-disable UnknownFilter %}
    view-event-payload="{{ product | standard_event_data: 'view' | escape }}"
    {% # theme-check-enable UnknownFilter %}
  >
    {% assign render_order_array = render_order | split: ',' %}
    {% capture media %}
      <div
        class="product-information__media"
        data-testid="product-information-media"
      >
        {{ media_gallery }}

        {% if request.page_type == 'product' or template.name == 'product' %}
          <div class="pdp-under-gallery-row">
            <span class="pdp-under-gallery-title">{{ product.metafields.custom.viewing_title.value | default: product.title | upcase }}</span>
            <div class="pdp-under-gallery-swatches">
              <span class="pdp-swatch-dot pdp-swatch-dot--bronze" title="Rose Gold"></span>
              <span class="pdp-swatch-dot pdp-swatch-dot--silver" title="Silver"></span>
              <span class="pdp-swatch-dot pdp-swatch-dot--gold" title="Yellow Gold"></span>
            </div>
          </div>

          <div class="pdp-certificate-section">
            <h3 class="pdp-certificate-title">Add certificate</h3>
            <div class="pdp-certificate-card" data-cert-name="GGL CERTIFICATION" data-cert-price="Rs. 590.00">
              <div class="pdp-certificate-card__left">
                <div class="pdp-certificate-logo">
                  <span class="pdp-ggl-badge">GGL</span>
                  <span class="pdp-ggl-sub">Gulf Gem Lab</span>
                </div>
                <div class="pdp-certificate-info">
                  <strong>GGL CERTIFICATION</strong>
                  <span>Rs. 590.00</span>
                </div>
              </div>
              <button type="button" class="pdp-certificate-add-btn" onclick="togglePDPCertificate(this, 'GGL CERTIFICATION (+ Rs. 590.00)')">+ Add</button>
            </div>
            <div class="pdp-certificate-card" data-cert-name="IGI CERTIFICATION + 7 days lead time" data-cert-price="Rs. 1,180.00">
              <div class="pdp-certificate-card__left">
                <div class="pdp-certificate-logo pdp-certificate-logo--igi">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="10" stroke="#776856" stroke-width="1.2"/>
                    <path d="M12 6L14.5 10H9.5L12 6Z" fill="#776856"/>
                    <path d="M12 18L9.5 14H14.5L12 18Z" fill="#776856"/>
                  </svg>
                  <span class="pdp-igi-text">IGI</span>
                </div>
                <div class="pdp-certificate-info">
                  <strong>IGI CERTIFICATION + 7 days lead time</strong>
                  <span>Rs. 1,180.00</span>
                </div>
              </div>
              <button type="button" class="pdp-certificate-add-btn" onclick="togglePDPCertificate(this, 'IGI CERTIFICATION + 7 days lead time (+ Rs. 1,180.00)')">+ Add</button>
            </div>
          </div>
          <script>
            function togglePDPCertificate(btn, certVal) {
              const card = btn.closest('.pdp-certificate-card');
              const isSelected = card.classList.contains('is-selected');
              const form = document.querySelector('form[action*="/cart/add"]');
              
              // Deselect all cards
              document.querySelectorAll('.pdp-certificate-card').forEach(function(c) {
                c.classList.remove('is-selected');
                const b = c.querySelector('.pdp-certificate-add-btn');
                if (b) {
                  b.textContent = '+ Add';
                  b.classList.remove('is-added');
                }
              });

              // Remove existing hidden input if any
              const existingInput = form ? form.querySelector('input[name="properties[Certificate]"]') : null;
              if (existingInput) existingInput.remove();

              if (!isSelected) {
                // Select clicked card
                card.classList.add('is-selected');
                btn.textContent = '✓ Added';
                btn.classList.add('is-added');

                // Append hidden input to product cart form
                if (form) {
                  const input = document.createElement('input');
                  input.type = 'hidden';
                  input.name = 'properties[Certificate]';
                  input.value = certVal;
                  form.appendChild(input);
                }
              }
            }
          </script>
        {% endif %}
      </div>
    {% endcapture %}

    {% for block in render_order_array %}
      {% if block == 'media' and product_has_media %}
        {{ media }}
      {% elsif block == 'product-details' %}
        {{ product_details }}
      {% endif %}
    {% endfor %}
  </product-component>

  {{ additional_blocks }}
</div>

{% stylesheet %}
  .product-information {
    gap: var(--gap) 0;
  }

  /* Base grid layout */
  .product-information__grid {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  /* Default column positions */
  .product-details {
    order: 1;
  }

  .product-information__media {
    order: 0;
    width: 0;
    min-width: 100%;
  }

  .product-information__media .product-media-gallery__placeholder-image {
    width: 100%;
    height: 100%;
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .product-information__media {
      grid-column: 1 / -1;
    }

    .product-details {
      grid-column: 2 / 3;
    }
  }

  /* Desktop styles */
  @media screen and (min-width: 750px) {
    .product-information__grid {
      grid-column: 2;
    }

    /* Position when there is no media */
    .product-information__grid.product-information--media-none {
      .product-details {
        width: var(--narrow-content-width);
        margin: 0 auto;
      }
    }

    /* Position when there is media */
    .product-information__grid:not(.product-information--media-none) {
      /* Media on the left side */
      &.product-information--media-left {
        grid-template-columns: 1fr min(50vw, var(--sidebar-width));

        .product-information__media {
          padding-right: calc(var(--gap, 0) / 2);
        }

        .product-details {
          padding-left: calc(var(--gap, 0) / 2);
        }

        &:has(.media-gallery--extend) {
          grid-column: 1 / 3;
        }
      }

      /* Media on the right side */
      &.product-information--media-right {
        grid-template-columns: min(50vw, var(--sidebar-width)) 1fr;

        .product-information__media {
          padding-left: calc(var(--gap, 0) / 2);
          order: 1;
        }

        .product-details {
          padding-right: calc(var(--gap, 0) / 2);
          order: 0;
        }

        &:has(.media-gallery--extend) {
          grid-column: 2 / -1;
        }
      }

      /* Equal width columns */
      &.product-information__grid--half,
      &.product-information__grid--half:has(.media-gallery--extend) {
        grid-column: 1 / -1;
        grid-template-columns:
          var(--full-page-grid-margin) calc(var(--full-page-grid-central-column-width) / 2) calc(
            var(--full-page-grid-central-column-width) / 2
          )
          var(--full-page-grid-margin);

        &.product-information--media-left {
          .product-information__media {
            grid-column: 2 / 3;

            &:has(.media-gallery--extend) {
              grid-column: 1 / 3;
            }
          }

          .product-details {
            grid-column: 3 / 4;
          }
        }

        &.product-information--media-right {
          .product-information__media {
            grid-column: 3 / 4;

            &:has(.media-gallery--extend) {
              grid-column: 3 / -1;
            }
          }

          .product-details {
            grid-column: 2 / 3;
          }
        }
      }
    }

    /* Handle full width section */
    .section--full-width {
      .product-information__grid:not(.product-information--media-none) {
        &.product-information--media-left,
        &.product-information--media-right {
          grid-column: 1 / -1;
        }

        &.product-information--media-left .product-details {
          padding-inline-end: var(--padding-lg);
        }

        &.product-information--media-right .product-details {
          padding-inline-start: var(--padding-lg);
        }

        &.product-information__grid--half.product-information--media-left {
          .product-information__media {
            grid-column: 1 / 3;
          }

          .product-details {
            grid-column: 3 / -1;
          }
        }

        &.product-information__grid--half.product-information--media-right {
          .product-information__media {
            grid-column: 3 / -1;
          }

          .product-details {
            grid-column: 1 / 3;
          }
        }
      }
    }
  }

  /* Wider sidebar for large screens */
  @media screen and (min-width: 1200px) {
    .product-information__grid:not(
        .product-information__grid--half,
        .product-information--media-none
      ).product-information--media-left {
      grid-template-columns: 2fr 1fr;
    }

    .product-information__grid:not(
        .product-information__grid--half,
        .product-information--media-none
      ).product-information--media-right {
      grid-template-columns: 1fr 2fr;
    }
  }

  .product-information__grid--limit-details .product-details > .group-block {
    --details-max-width: var(--sidebar-width);
    max-width: var(--details-max-width);
  }

  @media screen and (min-width: 1600px) {
    .product-information__grid--limit-details .product-details > .group-block {
      --details-max-width: 32rem;
    }
  }

  /* If the header is sticky, make product details content stick underneath the header */
  body:has(#header-group #header-component[data-sticky-state='active']) .product-details.sticky-content--desktop {
    --sticky-header-offset: var(--header-height);
  }

  /* PDP Collection Subtitle & Compact Container Constraints */
  .pdp-collection-subtitle {
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #121212;
    margin-bottom: 24px;
    grid-column: 1 / -1;
    width: 100%;
    display: block;
    white-space: nowrap;
  }

  /* Pure White Background & Compact Container Alignment for PDP Page */
  body.template-product,
  body[data-template='product'],
  body.template-product .page-wrapper,
  body.template-product #MainContent,
  body.template-product .product-information,
  body.template-product .section-background,
  body[data-template='product'] .section-background {
    background: #ffffff !important;
    background-color: #ffffff !important;
  }

  body.template-product .product-information,
  body[data-template='product'] .product-information {
    max-width: 1150px !important;
    margin-inline: auto !important;
    padding-inline: 24px !important;
    padding-block-start: 90px !important;
  }

  /* Sticky Desktop Media Column (Includes Gallery, Title/Swatches & Certificate Cards as ONE unit) */
  @media screen and (min-width: 750px) {
    body.template-product .product-information__media,
    body[data-template='product'] .product-information__media {
      position: sticky !important;
      top: calc(var(--header-height, 52px) + 20px) !important;
      align-self: flex-start !important;
      height: fit-content !important;
      z-index: 2 !important;
    }

    body.template-product .product-information__media :is(media-gallery, .sticky-content, .product-media-gallery, [data-testid="product-information-media"] > *) {
      position: relative !important;
      top: auto !important;
      height: auto !important;
    }
  }

  /* Under Gallery Title & Swatches Row */
  .pdp-under-gallery-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
    margin-bottom: 28px;
    padding-inline: 4px;
  }

  .pdp-under-gallery-title {
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #121212;
  }

  .pdp-under-gallery-swatches {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pdp-swatch-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: inline-block;
    cursor: pointer;
    border: 1px solid rgba(0, 0, 0, 0.18);
    transition: transform 0.2s ease;
  }

  .pdp-swatch-dot:hover {
    transform: scale(1.18);
  }

  .pdp-swatch-dot--bronze {
    background-color: #c5a368;
  }

  .pdp-swatch-dot--silver {
    background-color: #d1d1d1;
    border-color: #a8a8a8;
  }

  .pdp-swatch-dot--gold {
    background-color: #e6c687;
  }

  /* Add Certificate Section */
  .pdp-certificate-section {
    margin-top: 28px;
    max-width: 440px;
  }

  .pdp-certificate-title {
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: #222222;
    margin-bottom: 14px;
  }

  .pdp-certificate-card {
    border: 1px solid #d4d4d4;
    border-radius: 10px;
    padding: 12px 16px;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    transition: border-color 0.2s ease;
  }

  .pdp-certificate-card.is-selected {
    border-color: #121212;
    background-color: #f6f6f6;
  }

  .pdp-certificate-add-btn.is-added {
    background: #000000;
    color: #ffffff;
    box-shadow: inset 0 0 0 1px #000000;
  }

  .pdp-certificate-add-btn:hover {
    opacity: 0.85;
  }

  .pdp-certificate-card__left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pdp-certificate-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid #c0a060;
    padding: 3px 8px;
    border-radius: 4px;
    background: #faf8f5;
    min-width: 52px;
  }

  .pdp-certificate-logo--igi {
    border-color: #bbbbbb;
    background: #ffffff;
    flex-direction: row;
    gap: 4px;
    padding: 4px 6px;
  }

  .pdp-igi-text {
    font-size: 0.85rem;
    font-weight: 800;
    color: #121212;
    letter-spacing: 0.05em;
  }

  .pdp-ggl-badge {
    font-size: 0.82rem;
    font-weight: 800;
    color: #631828;
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .pdp-ggl-sub {
    font-size: 0.42rem;
    color: #631828;
    white-space: nowrap;
    line-height: 1.2;
    margin-top: 2px;
  }

  .pdp-certificate-info {
    display: flex;
    flex-direction: column;
  }

  .pdp-certificate-info strong {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #121212;
  }

  .pdp-certificate-info span {
    font-size: 0.72rem;
    color: #607d8b;
    font-style: normal;
    margin-top: 2px;
  }

  .pdp-certificate-add-btn {
    background: #191919;
    border: none;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #ffffff;
    cursor: pointer;
    padding: 8px 18px;
    transition: opacity 0.2s ease, background-color 0.2s ease;
  }

  .pdp-certificate-add-btn:hover {
    opacity: 0.85;
  }

  /* PDP Right Column Header, Typography & Specs */
  body.template-product .product-details h1,
  body[data-template='product'] .product-details h1,
  .pdp-main-title {
    font-family: var(--font-body--family, sans-serif) !important;
    font-size: 1.15rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    color: #121212 !important;
    margin: 0 0 4px 0 !important;
    line-height: 1.25 !important;
  }

  body.template-product .product-details h1::after,
  body[data-template='product'] .product-details h1::after {
    content: "EARRINGS\A\A 18K GOLD\A 3CT NET CVD DIAMOND\A INVISIBLE SETTING";
    white-space: pre-wrap;
    display: block;
    font-size: 0.68rem;
    font-weight: 400;
    font-style: italic;
    letter-spacing: 0.06em;
    color: #555555;
    margin-top: 4px;
    margin-bottom: 20px;
    line-height: 1.5;
    text-transform: uppercase;
  }

  /* Price styling for PDP */
  body.template-product .product-details price-component,
  body[data-template='product'] .product-details price-component {
    font-family: var(--font-body--family, sans-serif) !important;
    font-size: 1.05rem !important;
    font-weight: 600 !important;
    color: #121212 !important;
    letter-spacing: 0.02em !important;
    margin-top: 12px !important;
    margin-bottom: 20px !important;
  }

  /* Inline Action Buttons (ADD TO BAG | BUY NOW | CUSTOMISE) */
  .pdp-cta-row {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 20px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .pdp-cta-item {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #121212;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .pdp-cta-item--add {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .pdp-cta-item--buy,
  .pdp-cta-item--customise {
    font-style: italic;
  }

  .pdp-cta-item:hover {
    opacity: 0.6;
  }

  /* Accordion Headers Typography */
  body.template-product .product-details summary,
  body[data-template='product'] .product-details summary {
    font-family: var(--font-body--family, sans-serif) !important;
    font-size: 0.75rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    color: #333333 !important;
  }

  /* Visually hide theme native buy buttons container while preserving form DOM elements for custom CTAs */
  .product-details .buy-buttons-block .product-form-buttons {
    display: none !important;
  }

  /* Hide App Embed Certificate / Essential Upsell / Variant King Widgets on Right Column */
  .product-details :is([class*="sa-variant"], [id*="sa-variant"], [class*="variant-king"], [id*="variant-king"], [data-block-id*="sa-variant"], [data-app*="sa-variant"], [class*="essential-upsell"], [id*="essential-upsell"], [class*="upsell"], [data-app*="upsell"], [data-block-id*="essential"]) {
    display: none !important;
  }
{% endstylesheet %}
