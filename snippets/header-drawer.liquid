{%- doc -%}
  Renders a full-screen luxury editorial header drawer menu.
{%- enddoc -%}

{% render 'summary-icon-styles' %}

<script
  src="{{ 'header-drawer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<style>
  .menu-drawer-container[open] summary.header__icon--menu {
    position: fixed !important;
    top: 21px !important;
    left: 40px !important;
    z-index: 10000000 !important;
  }

  .tishva-hamburger-btn {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
    width: 45px;
    height: 28px;
    cursor: pointer;
    background: transparent;
    border: none;
    padding: 0;
  }

  .tishva-hamburger-line {
    display: block;
    width: 100%;
    height: 1.5px;
    background-color: currentColor;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.3s ease;
    transform-origin: center;
  }

  /* Morph 2 parallel lines into X icon & transform color to black on open */
  .menu-drawer-container[open] .tishva-hamburger-line {
    background-color: #000000 !important;
  }

  .menu-drawer-container[open] .tishva-hamburger-line:nth-child(1) {
    transform: translateY(5.75px) rotate(45deg);
  }

  .menu-drawer-container[open] .tishva-hamburger-line:nth-child(2) {
    transform: translateY(-5.75px) rotate(-45deg);
  }

  @media screen and (max-width: 749px) {
    .menu-drawer-container[open] summary.header__icon--menu {
      top: 16px !important;
      left: 20px !important;
    }
  }
</style>

<header-drawer class="header-drawer {{ class }}">
  <details
    id="Details-menu-drawer-container"
    data-skip-node-update="true"
    class="menu-drawer-container"
    ref="details"
    scroll-lock
  >
    <summary
      class="header__icon header__icon--menu header__icon--summary"
      aria-label="{{ 'accessibility.menu' | t }}"
      on:click="/toggle"
    >
      <div class="tishva-hamburger-btn">
        <span class="tishva-hamburger-line"></span>
        <span class="tishva-hamburger-line"></span>
      </div>
    </summary>

    {% render 'fullscreen-mega-menu', linklist: linklist, block: block, section: section %}

    <div
      class="menu-drawer__backdrop"
      on:click="header-drawer/close"
    ></div>
  </details>
</header-drawer>
