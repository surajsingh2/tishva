{%- doc -%}
  Renders the Full-Screen Luxury Editorial Hamburger Overlay Menu matching the reference wireframe.

  @param {object} linklist - The primary navigation menu
  @param {object} [block] - The block settings
  @param {object} [section] - The section settings
{%- enddoc -%}

<style>
  /* Lock Fullscreen Overlay Modal to Viewport (100vw x 100vh) */
  .menu-drawer-container[open] .menu-drawer.tishva-fullscreen-menu {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    max-width: 100vw !important;
    max-height: 100vh !important;
    margin: 0 !important;
    margin-top: 0 !important;
    padding: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    background: #ffffff !important;
    color: #121212 !important;
    z-index: 9999999 !important;
    box-sizing: border-box !important;
    overflow: hidden !important;
    transform: none !important;
    contain: none !important;
    opacity: 1 !important;
    visibility: visible !important;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s ease !important;
  }

  .menu-drawer.tishva-fullscreen-menu {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background: #ffffff !important;
    z-index: 9999999 !important;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s ease !important;
  }

  /* ABSOLUTE Top Bar Pinned to Y=0 (Never moves or scrolls off screen) */
  .tishva-fullscreen-menu .tishva-menu__top-bar {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    height: 70px !important;
    padding-inline: 40px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    background: #ffffff !important;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08) !important;
    z-index: 100000 !important;
    box-sizing: border-box !important;
    margin: 0 !important;
  }

  .tishva-fullscreen-menu,
  .tishva-fullscreen-menu * {
    color: #121212;
  }

  .tishva-fullscreen-menu .tishva-menu__close-btn {
    flex: 0 0 140px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    background: transparent !important;
    border: none !important;
    cursor: pointer !important;
    padding: 0 !important;
  }

  .tishva-fullscreen-menu .tishva-menu__close-btn svg {
    stroke: #000000 !important;
    fill: none !important;
    width: 26px !important;
    height: 26px !important;
  }

  .tishva-fullscreen-menu .tishva-menu__close-btn:hover {
    transform: scale(1.08);
  }

  .tishva-fullscreen-menu .tishva-menu__logo {
    flex: 1 !important;
    display: flex !important;
    justify-content: center !important;
    text-align: center !important;
    font-family: var(--font-heading--family, 'Gilda Display', serif) !important;
    font-size: 1.5rem !important;
    font-weight: 400 !important;
    letter-spacing: 0.15em !important;
    text-transform: uppercase !important;
    color: #000000 !important;
    text-decoration: none !important;
    line-height: 1 !important;
  }

  .tishva-fullscreen-menu .tishva-menu__logo * {
    color: #000000 !important;
    fill: #000000 !important;
  }

  .tishva-fullscreen-menu .tishva-menu__logo-img,
  .tishva-menu__logo-img {
    width: 90px !important;
    max-width: 90px !important;
    height: auto !important;
    object-fit: contain !important;
    filter: invert(1) !important;
  }

  .tishva-fullscreen-menu .tishva-menu__top-actions {
    flex: 0 0 140px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
  }

  .tishva-fullscreen-menu .tishva-search-label {
    color: #000000 !important;
  }

  .tishva-fullscreen-menu .tishva-search-line {
    background-color: #000000 !important;
  }

  /* Scrollable Middle Container (Positioned below the 70px top bar) */
  .tishva-fullscreen-menu .tishva-menu__main-scroll {
    position: absolute !important;
    top: 70px !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    overflow-y: auto !important;
    padding: 30px 40px 100px 40px !important;
    box-sizing: border-box !important;
    scrollbar-width: thin !important;
  }

  /* Tagline Section Label */
  .tishva-menu__section-tag {
    font-family: var(--font-body--family, monospace, sans-serif);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: #666666;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  /* Main Grid Layout */
  .tishva-menu__content-grid {
    display: grid;
    grid-template-columns: 3.2fr 1fr;
    gap: 50px;
    align-items: start;
  }

  /* 3 Primary Navigation Columns */
  .tishva-menu__nav-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .tishva-menu__col-title {
    font-family: var(--font-heading--family, 'Gilda Display', serif);
    font-size: 1.2rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 20px 0;
    color: #121212;
  }

  .tishva-menu__link-list {
    list-style: none;
    padding: 0;
    margin: 0 0 30px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tishva-menu__link {
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #333333;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .tishva-menu__link:hover {
    color: #000000;
    transform: translateX(4px);
  }

  /* Bottom Portrait Feature Thumbnails */
  .tishva-menu__col-thumbnail {
    width: 100%;
    max-width: 190px;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f8f8f8;
  }

  .tishva-menu__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tishva-menu__col-thumbnail:hover .tishva-menu__thumb-img {
    transform: scale(1.05);
  }

  .tishva-menu__thumb-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eaeaea;
  }

  /* Right Utility Column */
  .tishva-menu__utility-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .tishva-menu__utility-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-end;
    text-align: right;
  }

  .tishva-menu__utility-link {
    font-family: var(--font-body--family, sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #666666;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .tishva-menu__utility-link:hover {
    color: #121212;
  }

  /* Fixed Bottom Right Emblem Badge */
  .tishva-menu__badge-container {
    position: fixed;
    bottom: 30px;
    right: 50px;
    width: 120px;
    height: 120px;
    z-index: 1000000;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
  }

  .tishva-menu__badge-svg {
    width: 100%;
    height: 100%;
    animation: spinTishvaBadge 24s linear infinite;
  }

  @keyframes spinTishvaBadge {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .tishva-menu__badge-icon {
    position: absolute;
    font-size: 1.5rem;
    font-weight: 300;
    color: #8b0000;
  }

  /* Responsive Media Queries */
  @media screen and (max-width: 989px) {
    .tishva-fullscreen-menu .tishva-menu__top-bar {
      padding-inline: 20px !important;
      height: 60px !important;
    }

    .tishva-fullscreen-menu .tishva-menu__close-btn {
      flex: 0 0 60px !important;
    }

    .tishva-fullscreen-menu .tishva-menu__top-actions {
      flex: 0 0 100px !important;
    }

    .tishva-fullscreen-menu .tishva-menu__main-scroll {
      top: 60px !important;
      padding: 20px 20px 80px 20px !important;
    }

    .tishva-menu__logo {
      font-size: 1.3rem !important;
    }

    .tishva-menu__content-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .tishva-menu__nav-columns {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .tishva-menu__utility-list {
      align-items: flex-start;
      text-align: left;
    }

    .tishva-menu__badge-container {
      bottom: 20px;
      right: 20px;
      width: 90px;
      height: 90px;
    }
  }
</style>

<div
  ref="menuDrawer"
  class="menu-drawer tishva-fullscreen-menu"
>
  <!-- ABSOLUTE Fixed Top Bar (Close X, Logo, Search) -->
  <div class="tishva-menu__top-bar">
    <!-- Left placeholder for animated hamburger X trigger -->
    <div class="tishva-menu__top-bar-placeholder" style="flex: 0 0 140px;"></div>

    <a href="{{ routes.root_url }}" class="tishva-menu__logo">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 400 | image_tag: alt: shop.name, class: 'tishva-menu__logo-img' }}
      {%- else -%}
        <span>{{ shop.name | upcase }}</span>
      {%- endif -%}
    </a>

    <div class="tishva-menu__top-actions">
      {% render 'search' %}
    </div>
  </div>

  <!-- Scrollable Middle Content (Sits cleanly below 70px top bar) -->
  <div class="tishva-menu__main-scroll">
    <div class="tishva-menu__section-tag">// SHOP BY</div>

    <div class="tishva-menu__content-grid">
      <!-- 3 Primary Navigation Columns (COLLECTIONS, PRODUCTS, SHOP THE LOOK) -->
      <div class="tishva-menu__nav-columns">
        <!-- Column 1: COLLECTIONS -->
        <div class="tishva-menu__nav-col">
          <h3 class="tishva-menu__col-title">COLLECTIONS</h3>
          <ul class="tishva-menu__link-list" role="list">
            <li><a href="/collections/ragebait" class="tishva-menu__link">RAGEBAIT</a></li>
            <li><a href="/collections/in-scrutiny" class="tishva-menu__link">IN SCRUTINY</a></li>
            <li><a href="/collections/scandalicious" class="tishva-menu__link">SCANDALICIOUS</a></li>
          </ul>
          <div class="tishva-menu__col-thumbnail">
            {% assign thumb1 = collections['ragebait'].image | default: collections['scandalicious'].image | default: collections.first.image %}
            {%- if thumb1 != blank -%}
              {{ thumb1 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'tishva-menu__thumb-img', alt: 'COLLECTIONS' }}
            {%- else -%}
              <div class="tishva-menu__thumb-placeholder">
                {{ 'collection-1' | placeholder_svg_tag: 'tishva-menu__placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
        </div>

        <!-- Column 2: PRODUCTS -->
        <div class="tishva-menu__nav-col">
          <h3 class="tishva-menu__col-title">PRODUCTS</h3>
          <ul class="tishva-menu__link-list" role="list">
            <li><a href="/collections/necklace" class="tishva-menu__link">NECKLACE</a></li>
            <li><a href="/collections/pendant" class="tishva-menu__link">PENDANT</a></li>
            <li><a href="/collections/rings" class="tishva-menu__link">RINGS</a></li>
            <li><a href="/collections/earrings" class="tishva-menu__link">EARRINGS</a></li>
          </ul>
          <div class="tishva-menu__col-thumbnail">
            {% assign thumb2 = collections['necklace'].image | default: collections['rings'].image | default: collections.all[1].image %}
            {%- if thumb2 != blank -%}
              {{ thumb2 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'tishva-menu__thumb-img', alt: 'PRODUCTS' }}
            {%- else -%}
              <div class="tishva-menu__thumb-placeholder">
                {{ 'collection-2' | placeholder_svg_tag: 'tishva-menu__placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
        </div>

        <!-- Column 3: SHOP THE LOOK -->
        <div class="tishva-menu__nav-col">
          <h3 class="tishva-menu__col-title">SHOP THE LOOK</h3>
          <ul class="tishva-menu__link-list" role="list">
            <li><a href="/collections/old-school" class="tishva-menu__link">OLD SCHOOL</a></li>
            <li><a href="/collections/classics" class="tishva-menu__link">CLASSICS</a></li>
            <li><a href="/collections/everyday" class="tishva-menu__link">EVERYDAY</a></li>
            <li><a href="/collections/modern" class="tishva-menu__link">MODERN</a></li>
          </ul>
          <div class="tishva-menu__col-thumbnail">
            {% assign thumb3 = collections['old-school'].image | default: collections['classics'].image | default: collections.all[2].image %}
            {%- if thumb3 != blank -%}
              {{ thumb3 | image_url: width: 600 | image_tag: loading: 'lazy', class: 'tishva-menu__thumb-img', alt: 'SHOP THE LOOK' }}
            {%- else -%}
              <div class="tishva-menu__thumb-placeholder">
                {{ 'collection-3' | placeholder_svg_tag: 'tishva-menu__placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>

      <!-- Right Utility Column -->
      <div class="tishva-menu__utility-column">
        <ul class="tishva-menu__utility-list" role="list">
          {%- if shop.customer_accounts_enabled -%}
            {%- if customer -%}
              <li><a href="{{ routes.account_url }}" class="tishva-menu__utility-link">MY ACCOUNT ({{ customer.first_name | upcase }})</a></li>
            {%- else -%}
              <li><a href="{{ routes.account_login_url }}" class="tishva-menu__utility-link">MY ACCOUNT / LOG IN</a></li>
            {%- endif -%}
          {%- endif -%}
          <li><a href="{{ routes.cart_url }}" class="tishva-menu__utility-link">SHOPPING BAG ({% if cart != blank %}{{ cart.item_count }}{% else %}0{% endif %})</a></li>
          <li><a href="/pages/about-us" class="tishva-menu__utility-link">ABOUT US</a></li>
          <li><a href="/pages/contact" class="tishva-menu__utility-link">CONTACT US</a></li>
          <li><a href="/policies/privacy-policy" class="tishva-menu__utility-link">PRIVACY POLICY</a></li>
          <li><a href="/policies/refund-policy" class="tishva-menu__utility-link">RETURN & EXCHANGE</a></li>
          <li><a href="/policies/terms-of-service" class="tishva-menu__utility-link">TERMS & CONDITIONS</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Fixed Bottom Right Emblem Badge -->
  <div class="tishva-menu__badge-container">
    <svg class="tishva-menu__badge-svg" viewBox="0 0 100 100">
      <path id="tishvaCirclePath" d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="none" />
      <text font-size="8.2" font-weight="600" letter-spacing="1.4" fill="#121212">
        <textPath href="#tishvaCirclePath" startOffset="0%">
          FINE JEWELLERY • CERTIFIED LAB GROWN DIAMONDS •
        </textPath>
      </text>
    </svg>
    <div class="tishva-menu__badge-icon">+</div>
  </div>
</div>
