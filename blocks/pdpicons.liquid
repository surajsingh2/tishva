{% doc %}
  @prompt
    For my product page create a icon text for this content 1) year warranty.
    2) Free Shipping on orders above ₹2000.
    3) Easy returns within 14 Days.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
 .ai-icon-text-container-aaukxvurqdup5uvaybaigenblockb7dbee2eaxqb4 {
    display: flex;
    flex-direction: row;
    gap: 14px;
    
    padding: 20px;
    background-color: rgba(0,0,0,0);
    /* border: 1px solid black; */
    border-radius: 8px;
}

  .ai-icon-text-item-{{ ai_gen_id }} {
   display: flex
;
    align-items: center;
    text-align: center;
    justify-content: space-around;
    flex-direction: column;
    gap: 12px;
  }

  .ai-icon-text-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    color: {{ block.settings.icon_color }};
  }

  .ai-icon-text-content-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-icon-text-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    text-transform: uppercase;
    
    margin: 0 0 4px 0;
    line-height: 1.2;
  }

  .ai-icon-text-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-icon-text-container-{{ ai_gen_id }} {
      gap: {{ block.settings.item_spacing | times: 0.8 }}px;
      display: flex
;
        justify-content: center;
    }

    .ai-icon-text-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.9 }}px;
      height: {{ block.settings.icon_size | times: 0.9 }}px;
    }

    .ai-icon-text-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-icon-text-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-icon-text-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-icon-text-item-{{ ai_gen_id }}">
    <div class="ai-icon-text-icon-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
        <path d="m9 12 2 2 4-4"/>
      </svg>
    </div>
    <div class="ai-icon-text-content-{{ ai_gen_id }}">
      <h3 class="ai-icon-text-title-{{ ai_gen_id }}">{{ block.settings.warranty_title }}</h3>
      {% if block.settings.warranty_description != blank %}
        <p class="ai-icon-text-description-{{ ai_gen_id }}">{{ block.settings.warranty_description }}</p>
      {% endif %}
    </div>
  </div>

  <div class="ai-icon-text-item-{{ ai_gen_id }}">
    <div class="ai-icon-text-icon-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 3h5v5"/>
        <path d="M8 3H3v5"/>
        <path d="M12 22v-8.3a4 4 0 0 0-1.172-2.872L3 3"/>
        <path d="m15 9 6-6"/>
        <path d="M9 21h6"/>
        <path d="M9 21v-2a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/>
      </svg>
    </div>
    <div class="ai-icon-text-content-{{ ai_gen_id }}">
      <h3 class="ai-icon-text-title-{{ ai_gen_id }}">{{ block.settings.shipping_title }}</h3>
      {% if block.settings.shipping_description != blank %}
        <p class="ai-icon-text-description-{{ ai_gen_id }}">{{ block.settings.shipping_description }}</p>
      {% endif %}
    </div>
  </div>

  <div class="ai-icon-text-item-{{ ai_gen_id }}">
    <div class="ai-icon-text-icon-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 6h18l-2 13H5L3 6z"/>
        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
        <path d="M9 14h6"/>
      </svg>
    </div>
    <div class="ai-icon-text-content-{{ ai_gen_id }}">
      <h3 class="ai-icon-text-title-{{ ai_gen_id }}">{{ block.settings.returns_title }}</h3>
      {% if block.settings.returns_description != blank %}
        <p class="ai-icon-text-description-{{ ai_gen_id }}">{{ block.settings.returns_description }}</p>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Features",
  "settings": [
    {
      "type": "header",
      "content": "Warranty"
    },
    {
      "type": "text",
      "id": "warranty_title",
      "label": "Warranty title",
      "default": "1 Year Warranty"
    },
    {
      "type": "text",
      "id": "warranty_description",
      "label": "Warranty description"
    },
    {
      "type": "header",
      "content": "Shipping"
    },
    {
      "type": "text",
      "id": "shipping_title",
      "label": "Shipping title",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "shipping_description",
      "label": "Shipping description",
      "default": "On orders above ₹2000"
    },
    {
      "type": "header",
      "content": "Returns"
    },
    {
      "type": "text",
      "id": "returns_title",
      "label": "Returns title",
      "default": "Easy Returns"
    },
    {
      "type": "text",
      "id": "returns_description",
      "label": "Returns description",
      "default": "Within 14 days"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#008060"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 24
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 16
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 14
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "container_padding",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Container padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "item_spacing",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Space between items",
      "default": 16
    },
    {
      "type": "range",
      "id": "icon_text_spacing",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Space between icon and text",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Product Features"
    }
  ]
}
{% endschema %}