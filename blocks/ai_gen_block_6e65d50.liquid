{% doc %}
  @prompt
    Create a section with heading and paragrapgh to talk about the Why Lab-Grown Diamonds - Headline:
    Brilliance Without Compromise
    Body Copy:
    At Tishva, we believe luxury should be beautiful in every way - in how it looks, how it’s made,
    and how it makes you feel.
    That’s why we choose lab-grown diamonds.
    They offer the same brilliance, durability, and timeless appeal as mined diamonds, while being
    ethically created and environmentally responsible.
    By embracing lab-grown diamonds, we make fine jewellery more accessible, more conscious,
    and more aligned with the values of the modern woman.
    Every piece is crafted in hallmarked gold and set with IGI-certified diamonds, so you never
    have to choose between luxury and responsibility., can u make it like a split section right image left content where the points are in bulleted list
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-lab-grown-diamonds-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-lab-grown-diamonds__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-lab-grown-diamonds__content-{{ ai_gen_id }} {
    flex: 1;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-lab-grown-diamonds__image-wrapper-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-lab-grown-diamonds__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-lab-grown-diamonds__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-lab-grown-diamonds__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-lab-grown-diamonds__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-lab-grown-diamonds__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.spacing_below_heading }}px;
    line-height: 1.2;
  }

  .ai-lab-grown-diamonds__intro-{{ ai_gen_id }} {
    color: {{ block.settings.body_color }};
    font-size: {{ block.settings.body_size }}px;
    line-height: {{ block.settings.body_line_height }};
    margin: 0 0 {{ block.settings.spacing_below_intro }}px;
  }

  .ai-lab-grown-diamonds__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: left;
  }

  .ai-lab-grown-diamonds__list-item-{{ ai_gen_id }} {
    color: {{ block.settings.body_color }};
    font-size: {{ block.settings.body_size }}px;
    line-height: {{ block.settings.body_line_height }};
    margin-bottom: {{ block.settings.list_item_spacing }}px;
    padding-left: {{ block.settings.bullet_spacing }}px;
    position: relative;
  }

  .ai-lab-grown-diamonds__list-item-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-lab-grown-diamonds__list-item-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    left: 0;
    top: {{ block.settings.bullet_top_offset }}px;
    width: {{ block.settings.bullet_size }}px;
    height: {{ block.settings.bullet_size }}px;
    background-color: {{ block.settings.bullet_color }};
    border-radius: 50%;
  }

  @media screen and (max-width: 749px) {
    .ai-lab-grown-diamonds-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal_mobile }}px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-lab-grown-diamonds__container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.column_gap_mobile }}px;
    }

    .ai-lab-grown-diamonds__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-lab-grown-diamonds__intro-{{ ai_gen_id }},
    .ai-lab-grown-diamonds__list-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-lab-grown-diamonds-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-lab-grown-diamonds__container-{{ ai_gen_id }}">
    <div class="ai-lab-grown-diamonds__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-lab-grown-diamonds__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.intro_text != blank %}
        <div class="ai-lab-grown-diamonds__intro-{{ ai_gen_id }}">
          {{ block.settings.intro_text }}
        </div>
      {% endif %}

      <ul class="ai-lab-grown-diamonds__list-{{ ai_gen_id }}">
        {% if block.settings.list_item_1 != blank %}
          <li class="ai-lab-grown-diamonds__list-item-{{ ai_gen_id }}">
            {{ block.settings.list_item_1 }}
          </li>
        {% endif %}
        {% if block.settings.list_item_2 != blank %}
          <li class="ai-lab-grown-diamonds__list-item-{{ ai_gen_id }}">
            {{ block.settings.list_item_2 }}
          </li>
        {% endif %}
        {% if block.settings.list_item_3 != blank %}
          <li class="ai-lab-grown-diamonds__list-item-{{ ai_gen_id }}">
            {{ block.settings.list_item_3 }}
          </li>
        {% endif %}
        {% if block.settings.list_item_4 != blank %}
          <li class="ai-lab-grown-diamonds__list-item-{{ ai_gen_id }}">
            {{ block.settings.list_item_4 }}
          </li>
        {% endif %}
        {% if block.settings.list_item_5 != blank %}
          <li class="ai-lab-grown-diamonds__list-item-{{ ai_gen_id }}">
            {{ block.settings.list_item_5 }}
          </li>
        {% endif %}
      </ul>
    </div>

    <div class="ai-lab-grown-diamonds__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-lab-grown-diamonds__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-lab-grown-diamonds__image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
          <div class="ai-lab-grown-diamonds__empty-state-{{ ai_gen_id }}">
            Add an image
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

