            @{{ block.settings.instagram_username }}
          </a>
        {% endif %}
      </div>
    {% endif %}<div class="ai-instagram-carousel__wrapper-{{ ai_gen_id }}">
      <div class="ai-instagram-carousel__track-{{ ai_gen_id }}">
        {% for i in (1..12) %}
          {% assign image_key = 'image_' | append: i %}
          {% assign link_key = 'link_' | append: i %}
          {% assign image = block.settings[image_key] %}
          {% assign link = block.settings[link_key] %}
          {% if image != blank %}
            <div class="ai-instagram-carousel__slide-{{ ai_gen_id }}" data-slide="{{ forloop.index0 }}">
              {% if link != blank %}
                <a href="{{ link }}" target="_blank" rel="noopener noreferrer">
              {% endif %}
              
              <img
                src="{{ image | image_url: width: 400 }}"
                alt="{{ image.alt | escape }}"
                class="ai-instagram-carousel__image-{{ ai_gen_id }}"
                loading="lazy"
                width="400"
                height="400"
              ><div class="ai-instagram-carousel__overlay-{{ ai_gen_id }}">
                <svg class="ai-instagram-carousel__instagram-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
