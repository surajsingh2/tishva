                </svg>
              </div>
              
              {% if link != blank %}
                </a>
              {% endif %}
            </div>
          {% else %}
            <div class="ai-instagram-carousel__slide-{{ ai_gen_id }}" data-slide="{{ forloop.index0 }}">
              <div class="ai-instagram-carousel__image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if block.settings.show_controls %}
      <div class="ai-instagram-carousel__controls-{{ ai_gen_id }}">
        <button class="ai-instagram-carousel__nav-{{ ai_gen_id }}" data-direction="prev" aria-label="Previous slide">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15,18 9,12 15,6"></polyline>
          </svg>
        </button>
        
        <div class="ai-instagram-carousel__dots-{{ ai_gen_id }}"></div>
        
        <button class="ai-instagram-carousel__nav-{{ ai_gen_id }}" data-direction="next" aria-label="Next slide">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9,18 15,12 9,6"></polyline>
          </svg>
        </button>
