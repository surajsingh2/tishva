{% liquid
  assign collection = section.settings.collection
  
  # Resolve Title
  assign display_title = section.settings.title
  if display_title == blank and collection != blank
    assign display_title = collection.title
  endif
  if display_title == blank
    assign display_title = 'COLLECTION NAME'
  endif

  # Resolve Tagline
  assign display_tagline = section.settings.tagline
  if display_tagline == blank and collection != blank
    assign display_tagline = collection.metafields.custom.tagline
  endif
  if display_tagline == blank and collection != blank
    assign display_tagline = collection.description | strip_html | truncate: 80
  endif

  # Resolve Link
  assign display_link = section.settings.link
  if display_link == blank and collection != blank
    assign display_link = collection.url
  endif

  # Hybrid Image 1 (Primary)
  assign img_1 = section.settings.image_1
  if img_1 == blank and collection != blank and collection.image != blank
    assign img_1 = collection.image
  elsif img_1 == blank and collection != blank and collection.products[0].featured_image != blank
    assign img_1 = collection.products[0].featured_image
  endif

  # Hybrid Image 2 (Secondary)
  assign img_2 = section.settings.image_2
  if img_2 == blank and collection != blank and collection.metafields.custom.secondary_image != blank
    assign img_2 = collection.metafields.custom.secondary_image
  elsif img_2 == blank and collection != blank and collection.products[1].featured_image != blank
    assign img_2 = collection.products[1].featured_image
  endif

  # Hybrid Image 3 (Accent)
  assign img_3 = section.settings.image_3
  if img_3 == blank and collection != blank and collection.metafields.custom.accent_image != blank
    assign img_3 = collection.metafields.custom.accent_image
  elsif img_3 == blank and collection != blank and collection.products[2].featured_image != blank
    assign img_3 = collection.products[2].featured_image
  endif

  assign layout = section.settings.layout_style | default: 'style_1'
  assign enable_custom_pos = section.settings.enable_custom_positions
  if layout == 'custom'
    assign enable_custom_pos = true
  endif

  assign show_img_1 = section.settings.show_image_1 | default: true, allow_false: true
  assign show_img_2 = section.settings.show_image_2 | default: true, allow_false: true
  assign show_img_3 = section.settings.show_image_3 | default: true, allow_false: true
%}

{% capture title_content %}
  {% assign title_render_mode = section.settings.title_render_type | default: 'text' %}
  {% assign title_alt_text = section.settings.title_image_alt %}
  {% if title_alt_text == blank %}
    {% assign title_alt_text = display_title %}
  {% endif %}
  <div class="editorial-banner__title-wrapper">
    {% if title_render_mode == 'svg_image' and section.settings.title_image != blank %}
      <div class="editorial-banner__title-graphic">
        {{ section.settings.title_image | image_url: width: 1400 | image_tag: loading: 'eager', class: 'editorial-banner__title-img', alt: title_alt_text }}
      </div>
    {% else %}
      <h2 class="editorial-banner__title editorial-banner__title--main">
        {{ display_title }}
      </h2>
    {% endif %}
  </div>
{% endcapture %}

<div
  id="EditorialBanner-{{ section.id }}"
  class="editorial-banner editorial-banner--{{ layout }}{% if enable_custom_pos %} editorial-banner--custom-canvas{% endif %} editorial-banner--mob-{{ section.settings.mobile_layout | default: 'stack' }}"
  style="
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}
    --canvas-min-height: {{ section.settings.canvas_min_height | default: 600 }}px;

    --img1-width: {{ section.settings.image_1_width | default: 35 }}%;
    --img1-x: {{ section.settings.image_1_pos_x | default: 0 }}%;
    --img1-y: {{ section.settings.image_1_pos_y | default: 0 }}px;
    --img1-z: {{ section.settings.image_1_z_index | default: 2 }};
    --img1-rotate: {{ section.settings.image_1_rotation | default: 0 }}deg;
    --img1-aspect: {% if section.settings.image_1_aspect_ratio != 'auto' %}{{ section.settings.image_1_aspect_ratio }}{% else %}auto{% endif %};

    --img2-width: {{ section.settings.image_2_width | default: 25 }}%;
    --img2-x: {{ section.settings.image_2_pos_x | default: 60 }}%;
    --img2-y: {{ section.settings.image_2_pos_y | default: 60 }}px;
    --img2-z: {{ section.settings.image_2_z_index | default: 3 }};
    --img2-rotate: {{ section.settings.image_2_rotation | default: 0 }}deg;
    --img2-aspect: {% if section.settings.image_2_aspect_ratio != 'auto' %}{{ section.settings.image_2_aspect_ratio }}{% else %}auto{% endif %};

    --img3-width: {{ section.settings.image_3_width | default: 20 }}%;
    --img3-x: {{ section.settings.image_3_pos_x | default: 74 }}%;
    --img3-y: {{ section.settings.image_3_pos_y | default: -40 }}px;
    --img3-z: {{ section.settings.image_3_z_index | default: 1 }};
    --img3-rotate: {{ section.settings.image_3_rotation | default: 0 }}deg;
    --img3-aspect: {% if section.settings.image_3_aspect_ratio != 'auto' %}{{ section.settings.image_3_aspect_ratio }}{% else %}auto{% endif %};

    --content-x: {{ section.settings.content_pos_x | default: 0 }}%;
    --content-y: {{ section.settings.content_pos_y | default: 0 }}px;
    --content-z: {{ section.settings.content_z_index | default: 5 }};
    --title-font-size: {{ section.settings.title_font_size | default: 56 }}px;
    --title-text-transform: {{ section.settings.title_text_transform | default: 'none' }};
    --title-graphic-width: {{ section.settings.title_graphic_width | default: 100 }}%;
    --title-x: {{ section.settings.title_pos_x | default: 0 }}%;
    --title-y: {{ section.settings.title_pos_y | default: 0 }}px;
    --title-z: {{ section.settings.title_z_index | default: 5 }};
    --title-rotate: {{ section.settings.title_rotation | default: 0 }}deg;

    --tagline-font-size: {{ section.settings.tagline_font_size | default: 14 }}px;
    --tagline-text-transform: {{ section.settings.tagline_text_transform | default: 'uppercase' }};
    {% if section.settings.tagline_color != blank %}--tagline-color: {{ section.settings.tagline_color }};{% endif %}
    --tagline-x: {{ section.settings.tagline_pos_x | default: 0 }}%;
    --tagline-y: {{ section.settings.tagline_pos_y | default: 0 }}px;
    --tagline-z: {{ section.settings.tagline_z_index | default: 5 }};
    --tagline-rotate: {{ section.settings.tagline_rotation | default: 0 }}deg;

    --divider-width: {{ section.settings.divider_width | default: 1 }}px;
    --divider-height: {{ section.settings.divider_height | default: 50 }}px;
    {% if section.settings.divider_color != blank %}--divider-color: {{ section.settings.divider_color }};{% endif %}
    --divider-x: {{ section.settings.divider_pos_x | default: 0 }}%;
    --divider-y: {{ section.settings.divider_pos_y | default: 0 }}px;
    --divider-z: {{ section.settings.divider_z_index | default: 5 }};
    --divider-rotate: {{ section.settings.divider_rotation | default: 0 }}deg;
  "
>
  <div class="editorial-banner__container page-width">
    {% if display_link != blank %}
      <a href="{{ display_link }}" class="editorial-banner__link-overlay" aria-label="{{ display_title | escape }}"></a>
    {% endif %}

    {% if layout == 'style_3' and enable_custom_pos == false %}
      <!-- Layout Style 3 Header -->
      <div class="editorial-banner__top-header">
        {{ title_content }}
      </div>
    {% endif %}

    <div class="editorial-banner__grid editorial-banner__grid--{{ layout }}">
      <!-- Primary Image Block -->
      {% if show_img_1 %}
        <div class="editorial-banner__media-block editorial-banner__media-block--primary">
          <div class="editorial-banner__image-wrapper editorial-banner__image-wrapper--img1">
            {% if img_1 != blank %}
              {{ img_1 | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'editorial-banner__image', alt: display_title }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'editorial-banner__placeholder' }}
            {% endif %}
          </div>
        </div>
      {% endif %}

      <!-- Center / Content Column -->
      <div class="editorial-banner__content-block">
        {% if layout != 'style_3' or enable_custom_pos %}
          {{ title_content }}
        {% endif %}

        <div class="editorial-banner__sub-container">
          {% if section.settings.show_divider %}
            <div class="editorial-banner__divider"></div>
          {% endif %}
          
          {% if display_tagline != blank %}
            <p class="editorial-banner__tagline">
              {{ display_tagline }}
            </p>
          {% endif %}
        </div>
      </div>

      <!-- Secondary & Accent Media Column -->
      {% if show_img_2 or show_img_3 %}
        <div class="editorial-banner__media-block editorial-banner__media-block--secondary">
          {% if show_img_2 %}
            {% if img_2 != blank or enable_custom_pos %}
              <div class="editorial-banner__image-wrapper editorial-banner__image-wrapper--img2">
                {% if img_2 != blank %}
                  {{ img_2 | image_url: width: 800 | image_tag: loading: 'lazy', class: 'editorial-banner__image', alt: display_title }}
                {% else %}
                  {{ 'collection-2' | placeholder_svg_tag: 'editorial-banner__placeholder' }}
                {% endif %}
              </div>
            {% endif %}
          {% endif %}

          {% if show_img_3 %}
            {% if img_3 != blank or enable_custom_pos %}
              {% if layout != 'style_1' or enable_custom_pos %}
                <div class="editorial-banner__image-wrapper editorial-banner__image-wrapper--img3">
                  {% if img_3 != blank %}
                    {{ img_3 | image_url: width: 800 | image_tag: loading: 'lazy', class: 'editorial-banner__image', alt: display_title }}
                  {% else %}
                    {{ 'collection-3' | placeholder_svg_tag: 'editorial-banner__placeholder' }}
                  {% endif %}
                </div>
              {% endif %}
            {% endif %}
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .editorial-banner {
    position: relative;
    padding-top: var(--padding-top, 60px);
    padding-bottom: var(--padding-bottom, 60px);
    overflow: hidden;
  }

  .editorial-banner__container {
    position: relative;
    max-width: 1300px;
    margin: 0 auto;
  }

  .editorial-banner__link-overlay {
    position: absolute;
    inset: 0;
    z-index: 20;
  }

  .editorial-banner__grid {
    display: grid;
    align-items: center;
    gap: 30px;
  }

  /* Image styling & micro-animation */
  .editorial-banner__image-wrapper {
    position: relative;
    overflow: hidden;
  }

  .editorial-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .editorial-banner__container:hover .editorial-banner__image {
    transform: scale(1.03);
  }

  .editorial-banner__placeholder {
    width: 100%;
    height: 100%;
    background: #f4f4f4;
  }

  /* Typography & Title Wrapper Positioning */
  .editorial-banner__title-wrapper {
    display: inline-block;
    position: relative;
    z-index: var(--title-z, 5);
    transform: translate(var(--title-x, 0%), var(--title-y, 0px)) rotate(var(--title-rotate, 0deg));
    transition: transform 0.3s ease;
  }

  .editorial-banner__title {
    font-family: var(--font-heading--family, 'Gilda Display', serif);
    font-size: var(--title-font-size, clamp(2.4rem, 5vw, 4.8rem));
    font-weight: 400;
    line-height: 0.95;
    margin: 0;
    color: #121212;
    text-transform: var(--title-text-transform, none);
    letter-spacing: -0.01em;
  }

  .editorial-banner__tagline {
    font-family: var(--font-body--family, sans-serif);
    font-size: var(--tagline-font-size, 14px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: var(--tagline-text-transform, uppercase);
    margin: 0;
    color: var(--tagline-color, #2b2b2b);
    position: relative;
    z-index: var(--tagline-z, 5);
    transform: translate(var(--tagline-x, 0%), var(--tagline-y, 0px)) rotate(var(--tagline-rotate, 0deg));
    transition: transform 0.3s ease;
  }

  .editorial-banner__divider {
    width: var(--divider-width, 1px);
    height: var(--divider-height, 50px);
    background-color: var(--divider-color, #121212);
    margin: 15px 0;
    position: relative;
    z-index: var(--divider-z, 5);
    transform: translate(var(--divider-x, 0%), var(--divider-y, 0px)) rotate(var(--divider-rotate, 0deg));
    transition: transform 0.3s ease;
  }

  /* Graphic Title Options */
  .editorial-banner__title-graphic {
    display: inline-block;
    width: var(--title-graphic-width, 100%);
    max-width: 100%;
    margin: 0 auto;
  }

  .editorial-banner__title-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  /* Standard Layout 1: Scandalicious Style */
  .editorial-banner__grid--style_1 {
    grid-template-columns: 1fr 1.2fr 0.8fr;
  }

  .editorial-banner__grid--style_1 .editorial-banner__media-block--primary {
    max-width: 420px;
    aspect-ratio: 3/4;
  }

  .editorial-banner__grid--style_1 .editorial-banner__title--main {
    font-size: var(--title-font-size, clamp(3rem, 7vw, 6rem));
    text-align: center;
  }

  .editorial-banner__grid--style_1 .editorial-banner__sub-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 30px;
  }

  .editorial-banner__grid--style_1 .editorial-banner__image-wrapper--img2 {
    max-width: 350px;
    aspect-ratio: 1 / 2;
    margin-left: auto;
    position: relative;
    top: 180px;
    right: 48%;
    overflow: hidden;
  }

  /* Standard Layout 2: Ragebait Style */
  .editorial-banner__grid--style_2 {
    grid-template-columns: 1.1fr 1fr 0.9fr;
  }

  .editorial-banner__grid--style_2 .editorial-banner__media-block--primary {
    max-width: 450px;
    aspect-ratio: 4/5;
  }

  .editorial-banner__grid--style_2 .editorial-banner__title--main {
    font-size: var(--title-font-size, clamp(2.8rem, 6.5vw, 5.5rem));
    text-align: center;
    text-transform: var(--title-text-transform, none);
  }

  .editorial-banner__grid--style_2 .editorial-banner__media-block--secondary {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .editorial-banner__grid--style_2 .editorial-banner__image-wrapper--img2 {
    width: 80%;
    margin-left: auto;
    aspect-ratio: 1/1;
  }

  .editorial-banner__grid--style_2 .editorial-banner__image-wrapper--img3 {
    width: 60%;
    aspect-ratio: 3/4;
  }

  .editorial-banner__grid--style_2 .editorial-banner__sub-container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: 40px;
  }

  /* Standard Layout 3: In Scrutiny Style */
  .editorial-banner__top-header {
    margin-bottom: 25px;
    text-align: center;
  }

  .editorial-banner__grid--style_3 {
    grid-template-columns: 1.2fr 0.8fr 1fr;
  }

  .editorial-banner__grid--style_3 .editorial-banner__title--top {
    font-size: var(--title-font-size, clamp(3rem, 8vw, 7rem));
  }

  .editorial-banner__grid--style_3 .editorial-banner__media-block--primary {
    aspect-ratio: 1/1;
  }

  .editorial-banner__grid--style_3 .editorial-banner__image-wrapper--img2 {
    aspect-ratio: 4/5;
  }

  .editorial-banner__grid--style_3 .editorial-banner__sub-container {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    margin-top: 60px;
  }

  .editorial-banner__grid--style_3 .editorial-banner__divider {
    margin-left: auto;
  }

  /* ==========================================================================
     Custom Canvas (Free Placement & Overlapping Mode)
     ========================================================================== */
  .editorial-banner--custom-canvas .editorial-banner__container {
    min-height: var(--canvas-min-height, 600px);
  }

  .editorial-banner--custom-canvas .editorial-banner__grid {
    display: block !important;
    position: relative !important;
    min-height: var(--canvas-min-height, 600px) !important;
    width: 100%;
  }

  .editorial-banner--custom-canvas .editorial-banner__media-block--primary,
  .editorial-banner--custom-canvas .editorial-banner__media-block--secondary {
    display: contents !important;
  }

  /* Image 1 Free Position */
  .editorial-banner--custom-canvas .editorial-banner__image-wrapper--img1 {
    position: absolute !important;
    width: var(--img1-width, 35%) !important;
    left: var(--img1-x, 0%) !important;
    top: var(--img1-y, 0px) !important;
    z-index: var(--img1-z, 2) !important;
    transform: rotate(var(--img1-rotate, 0deg));
    aspect-ratio: var(--img1-aspect, 3/4);
    max-width: none !important;
    margin: 0 !important;
    pointer-events: auto;
  }

  /* Image 2 Free Position */
  .editorial-banner--custom-canvas .editorial-banner__image-wrapper--img2 {
    position: absolute !important;
    width: var(--img2-width, 25%) !important;
    left: var(--img2-x, 60%) !important;
    top: var(--img2-y, 60px) !important;
    z-index: var(--img2-z, 3) !important;
    transform: rotate(var(--img2-rotate, 0deg));
    aspect-ratio: var(--img2-aspect, 1/2);
    max-width: none !important;
    margin: 0 !important;
    right: auto !important;
    pointer-events: auto;
  }

  /* Image 3 Free Position */
  .editorial-banner--custom-canvas .editorial-banner__image-wrapper--img3 {
    position: absolute !important;
    width: var(--img3-width, 20%) !important;
    left: var(--img3-x, 74%) !important;
    top: var(--img3-y, -40px) !important;
    z-index: var(--img3-z, 1) !important;
    transform: rotate(var(--img3-rotate, 0deg));
    aspect-ratio: var(--img3-aspect, 1/1);
    max-width: none !important;
    margin: 0 !important;
    right: auto !important;
    pointer-events: auto;
  }

  /* Content Block Free Layering */
  .editorial-banner--custom-canvas .editorial-banner__content-block {
    position: relative !important;
    z-index: var(--content-z, 5) !important;
    transform: translate(var(--content-x, 0%), var(--content-y, 0px)) !important;
    width: max-content;
    max-width: 100%;
    margin: 0 auto;
    pointer-events: auto;
  }

  /* Mobile Responsive Breakpoints */
  @media screen and (max-width: 749px) {
    .editorial-banner--mob-stack .editorial-banner__grid {
      display: flex !important;
      flex-direction: column !important;
      gap: 24px !important;
      min-height: auto !important;
    }

    .editorial-banner--mob-stack .editorial-banner__media-block--primary,
    .editorial-banner--mob-stack .editorial-banner__media-block--secondary {
      display: flex !important;
      flex-direction: column !important;
      gap: 24px !important;
    }

    .editorial-banner--mob-stack .editorial-banner__image-wrapper--img1,
    .editorial-banner--mob-stack .editorial-banner__image-wrapper--img2,
    .editorial-banner--mob-stack .editorial-banner__image-wrapper--img3 {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      max-width: 100% !important;
      transform: none !important;
      margin: 0 !important;
      z-index: 1 !important;
    }

    .editorial-banner--mob-stack .editorial-banner__content-block {
      position: relative !important;
      transform: none !important;
      width: 100% !important;
      text-align: center !important;
    }

    .editorial-banner__title {
      font-size: var(--title-font-size, 2.8rem) !important;
      text-align: center !important;
    }

    .editorial-banner__sub-container {
      align-items: center !important;
      text-align: center !important;
    }

    .editorial-banner__divider {
      margin-left: auto !important;
      margin-right: auto !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial Collection",
  "tag": "section",
  "class": "section-editorial-banner",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "options": [
        {
          "value": "style_1",
          "label": "Style 1 (Scandalicious - Split Title)"
        },
        {
          "value": "style_2",
          "label": "Style 2 (Ragebait - Stacked Grid)"
        },
        {
          "value": "style_3",
          "label": "Style 3 (In Scrutiny - Top Header)"
        },
        {
          "value": "custom",
          "label": "Custom Canvas (Free Placement & Overlapping)"
        }
      ],
      "default": "custom"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_positions",
      "label": "Enable Custom Positioning & Overlapping",
      "info": "Check to freely adjust image position, rotation, width, and z-index layer stacking regardless of preset layout.",
      "default": true
    },
    {
      "type": "range",
      "id": "canvas_min_height",
      "min": 300,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Canvas minimum height",
      "default": 600
    },
    {
      "type": "header",
      "content": "Title & SVG Typography Settings"
    },
    {
      "type": "select",
      "id": "title_render_type",
      "label": "Title Render Mode",
      "options": [
        { "value": "text", "label": "Standard Text Title" },
        { "value": "svg_image", "label": "Uploaded SVG / Image Title Graphic" }
      ],
      "default": "text",
      "info": "Choose how to display the title: standard text or uploaded SVG / image graphic."
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title override (Text)",
      "info": "Leave blank to pull from Collection Title."
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Title Text Font Size",
      "default": 56
    },
    {
      "type": "select",
      "id": "title_text_transform",
      "label": "Title Text Case",
      "options": [
        { "value": "none", "label": "As Typed (Original Case)" },
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "lowercase", "label": "lowercase" },
        { "value": "capitalize", "label": "Capitalize Each Word" }
      ],
      "default": "none",
      "info": "Control letter casing for standard text titles."
    },
    {
      "type": "image_picker",
      "id": "title_image",
      "label": "Title SVG / Image Graphic",
      "info": "Upload custom SVG or image logo. Used when Render Mode is set to Uploaded SVG / Image Title Graphic."
    },
    {
      "type": "text",
      "id": "title_image_alt",
      "label": "Title Graphic Alt Text (SEO & Accessibility)",
      "info": "Accessible text describing the SVG/Image title for screen readers and SEO. Defaults to collection title if blank."
    },
    {
